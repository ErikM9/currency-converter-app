{
  "name": "currency-converter",
  "version": "1.0.0",
  "type": "module",
  "description": "Currency converter with live exchange rates",
  "scripts": {
    "serve": "npx http-server src -p 3000 -c-1",
    "test": "node --test tests/unit/converter.test.js",
    "test:watch": "node --test --watch tests/unit/**/*.test.js",
    "test:e2e": "wdio run wdio.conf.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@wdio/cli": "^8.32.0",
    "@wdio/local-runner": "^8.32.0",
    "@wdio/mocha-framework": "^8.32.0",
    "@wdio/spec-reporter": "^8.32.0",
    "chromedriver": "latest",
    "http-server": "^14.1.1",
    "wdio-chromedriver-service": "^8.1.1"
  },
  "dependencies": {
    "devtools": "^8.42.0"
  }
}