{
  "name": "currency-converter",
  "version": "1.0.0",
  "type": "module",
  "description": "Currency converter with live exchange rates",
  "scripts": {
    "serve": "http-server src -p 3000 -c-1",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/scripts.js --test-coverage-lines=90 --test-coverage-branches=88 --test-coverage-functions=95",
    "test:e2e": "wdio run wdio.conf.js",
    "test:e2e:firefox": "wdio run wdio.firefox.conf.js",
    "test:all": "npm run test:coverage && npm run test:e2e"
  },
  "devDependencies": {
    "@wdio/cli": "^8.32.0",
    "@wdio/local-runner": "^8.32.0",
    "@wdio/mocha-framework": "^8.32.0",
    "@wdio/spec-reporter": "^8.32.0",
    "axe-core": "^4.13.0",
    "devtools": "^8.42.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.1",
    "webdriverio": "^8.32.0"
  }
}